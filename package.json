{
  "name": "chiwork-2026",
  "version": "1.0.0",
  "description": "Workshop website built with 11ty and Tailwind CSS",
  "scripts": {
    "start": "npm-run-all --parallel dev:*",
    "dev:eleventy": "eleventy --serve",
    "dev:css": "tailwindcss -i src/css/styles.css -o _site/css/styles.css --watch",
    "build": "NODE_ENV=production tailwindcss -i src/css/styles.css -o _site/css/styles.css && eleventy"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@tailwindcss/typography": "^0.5.15",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^3.4.0"
  }
}
