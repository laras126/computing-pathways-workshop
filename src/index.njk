---
layout: base.njk
---

{# ═══════════════════════════════════════════════════════════════
   HEADER — title, subtitle, tagline
   ═══════════════════════════════════════════════════════════════ #}
<header class="section border-b border-paper-200">
  <div class="container-prose">
    <p class="section-label">{{ workshop.subtitle }}</p>
    <h1 class="font-serif text-3xl md:text-4xl text-ink leading-tight mb-5">
      {{ workshop.title }}
    </h1>
    <p class="text-lg text-ink-light leading-relaxed max-w-prose">
      {{ workshop.tagline }}
    </p>
    <p class="mt-5 text-sm text-ink-muted">
      {{ workshop.venue }} &middot; {{ workshop.date }}
    </p>
  </div>
</header>


{# ═══════════════════════════════════════════════════════════════
   ABSTRACT
   ═══════════════════════════════════════════════════════════════ #}
<section class="section" id="about">
  <div class="container-prose">
    <p class="section-label">About</p>
    <div class="prose prose-workshop">
      {% renderFile "./src/content/abstract.md" %}
    </div>
  </div>
</section>


{# ═══════════════════════════════════════════════════════════════
   CALL FOR PARTICIPATION
   ═══════════════════════════════════════════════════════════════ #}
<section class="section section--alt" id="cfp">
  <div class="container-prose">
    <p class="section-label">Call for Participation</p>
    <h2 class="section-heading">Submit a position paper</h2>

    <div class="cfp-box prose prose-workshop">
      {% renderFile "./src/content/cfp.md" %}
    </div>

    <p class="cfp-deadline">Submission deadline: {{ workshop.cfp.deadline }}</p>

    <div class="divider"></div>

    <dl class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-sm">
      <div>
        <dt class="font-sans font-semibold text-ink-muted text-xs uppercase tracking-wider mb-1" style="letter-spacing:.1em">Submissions due</dt>
        <dd class="text-ink">{{ workshop.cfp.deadline }}</dd>
      </div>
      <div>
        <dt class="font-sans font-semibold text-ink-muted text-xs uppercase tracking-wider mb-1" style="letter-spacing:.1em">Notification</dt>
        <dd class="text-ink">{{ workshop.cfp.notification }}</dd>
      </div>
      <div>
        <dt class="font-sans font-semibold text-ink-muted text-xs uppercase tracking-wider mb-1" style="letter-spacing:.1em">Camera ready</dt>
        <dd class="text-ink">{{ workshop.cfp.camera_ready }}</dd>
      </div>
    </dl>

    <p class="mt-8">
      <a href="{{ workshop.cfp.submit_url }}"
         class="inline-block bg-accent text-paper-50 no-underline px-5 py-2.5 text-sm font-sans font-medium hover:bg-accent-hover transition-colors">
        Submit a paper
      </a>
    </p>
  </div>
</section>


{# ═══════════════════════════════════════════════════════════════
   SCHEDULE
   ═══════════════════════════════════════════════════════════════ #}
<section class="section" id="schedule">
  <div class="container-wide">
    <p class="section-label">Schedule</p>
    <h2 class="section-heading">Workshop program</h2>
    <p class="text-sm text-ink-muted mb-8">{{ workshop.date }} &middot; {{ workshop.venue }}</p>

    <table class="schedule-table">
      <thead>
        <tr>
          <th class="col-time">Time</th>
          <th class="col-event">Session</th>
          <th class="col-speaker">Speaker</th>
        </tr>
      </thead>
      <tbody>
        {% for row in schedule %}
          <tr class="{{ 'schedule-break' if row.type == 'break' else '' }}">
            <td class="col-time">{{ row.time }}</td>
            <td class="col-event">{{ row.event }}</td>
            <td class="col-speaker">{{ row.speaker if row.speaker }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>


{# ═══════════════════════════════════════════════════════════════
   ORGANIZERS
   ═══════════════════════════════════════════════════════════════ #}
<section class="section section--alt" id="organizers">
  <div class="container-prose">
    <p class="section-label">Organizers</p>
    <h2 class="section-heading">Who we are</h2>

    <ul class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-5 list-none p-0">
      {% for person in organizers %}
        <li class="organizer-item">
          <span class="organizer-name">
            {{ person.name }}
            {% if person.lead %}
              <span class="text-xs font-sans text-ink-muted font-400 ml-1">(lead)</span>
            {% endif %}
          </span>
          <span class="organizer-affiliation">{{ person.affiliation }}</span>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>


{# ═══════════════════════════════════════════════════════════════
   CONTACT
   ═══════════════════════════════════════════════════════════════ #}
<section class="section" id="contact">
  <div class="container-prose">
    <p class="section-label">Contact</p>
    <h2 class="section-heading">Get in touch</h2>

    <div class="contact-block mt-4 text-ink-light">
      <p>{{ workshop.contact.note }}</p>
      <p class="mt-3">
        {{ workshop.contact.name }}<br>
        <a href="mailto:{{ workshop.contact.email }}">{{ workshop.contact.email }}</a>
      </p>
    </div>
  </div>
</section>
