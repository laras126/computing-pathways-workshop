<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle if pageTitle else workshop.title }} — {{ workshop.subtitle }}</title>
  <meta name="description" content="{{ workshop.tagline }}">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

  <header class="border-b border-paper-200 bg-paper-50">
    <div class="container-prose py-10 md:py-14">

      <p class="section-label mb-3">{{ workshop.subtitle }}</p>

      <h1 class="font-serif text-2xl md:text-3xl text-ink leading-snug mb-4" style="max-width: 22em;">
        {{ workshop.title }}
      </h1>

      <p class="text-base text-ink-light leading-relaxed mb-5" style="max-width: 54ch;">
        {{ workshop.tagline }}
      </p>

      <dl class="flex flex-wrap gap-x-6 gap-y-1 text-sm text-ink-muted">
        <div class="flex gap-1.5">
          <dt class="sr-only">Date</dt>
          <dd>{{ workshop.date }}</dd>
        </div>
        <div class="flex gap-1.5 before:content-['·'] before:select-none">
          <dt class="sr-only">Venue</dt>
          <dd>{{ workshop.venue }}</dd>
        </div>
      </dl>

    </div>
  </header>

  {{ content | safe }}

  <footer class="site-footer">
    <div class="container-prose">
      <p>{{ workshop.subtitle }} &middot; {{ workshop.venue }} &middot; {{ workshop.date }}</p>
    </div>
  </footer>

</body>
</html>
